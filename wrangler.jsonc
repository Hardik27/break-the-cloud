// Cloudflare Workers config: serves the built static site (dist/) on Cloudflare's network.
// Cloudflare runs `npm run build`, then `npx wrangler deploy` on every push to main.
// No server code: the games run in the browser and talk to Supabase directly.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "break-the-cloud",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist"
  },
  // The site lives only at its own domain; Cloudflare creates the DNS records and HTTPS certificates.
  "routes": [
    { "pattern": "breakthecloud.dev", "custom_domain": true },
    { "pattern": "www.breakthecloud.dev", "custom_domain": true }
  ],
  // No second public address on *.workers.dev (it would show the account name).
  "workers_dev": false,
  "preview_urls": false
}
